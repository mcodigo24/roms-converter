<Window x:Class="RomsConverter.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:RomsConverter.App.ViewModels"
        xmlns:conv="clr-namespace:RomsConverter.Core.Conversion;assembly=RomsConverter.Core"
        Title="{Binding Title}" Height="450" Width="800">
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="ConsoleButton" TargetType="Button">
            <Setter Property="Width" Value="220" />
            <Setter Property="Height" Value="120" />
            <Setter Property="Margin" Value="16" />
            <Setter Property="FontSize" Value="24" />
        </Style>
    </Window.Resources>
    <Grid>
        <!-- Pantalla 1: selección de consola -->
        <StackPanel Visibility="{Binding IsConsoleSelection, Converter={StaticResource BoolToVisibility}}"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="¿Qué consola querés convertir?" FontSize="24"
                       HorizontalAlignment="Center" Margin="0,0,0,16" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Style="{StaticResource ConsoleButton}" Content="PlayStation"
                        Command="{Binding SelectConsoleCommand}"
                        CommandParameter="{x:Static conv:ConsoleKind.PlayStation}" />
                <Button Style="{StaticResource ConsoleButton}" Content="PSP"
                        Command="{Binding SelectConsoleCommand}"
                        CommandParameter="{x:Static conv:ConsoleKind.Psp}" />
            </StackPanel>
        </StackPanel>

        <!-- Pantalla 2: cola (se completa en el paso 10) -->
        <TextBlock Visibility="{Binding IsConsoleSelected, Converter={StaticResource BoolToVisibility}}"
                   Text="{Binding SelectedConsoleName, StringFormat=Cola de conversión — {0}}"
                   FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Grid>
</Window>
